rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 「いいね」の付け外しが、自分ぶんの±1に収まっているかを見る。
    //
    // 以前は likeCount / likedBy の2つを触っていれば何でも通したので、
    // ログイン済みなら誰でも likeCount を好きな数字にでき、
    // likedBy から他人のいいねを消すこともできた。
    //
    // 付けるとき: likedBy に自分だけが増え、likeCount がちょうど +1
    // 外すとき  : likedBy から自分だけが減り、likeCount がちょうど -1
    // ※ 古いデータには likeCount / likedBy が無いことがあるので get(キー, 既定値) で読む
    function isOwnLikeToggle() {
      let uid = request.auth.uid;
      let before = resource.data.get('likedBy', []);
      let after = request.resource.data.get('likedBy', []);
      let beforeCount = resource.data.get('likeCount', 0);
      let afterCount = request.resource.data.get('likeCount', 0);
      return
        // いいねを付ける
        (!(uid in before) && (uid in after)
          && after.hasAll(before) && after.size() == before.size() + 1
          && afterCount == beforeCount + 1)
        ||
        // いいねを外す
        ((uid in before) && !(uid in after)
          && before.hasAll(after) && after.size() == before.size() - 1
          && afterCount == beforeCount - 1);
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /stones/{stoneId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        // 投稿者は自分の石を編集できる（写真追加もUI上は投稿者限定）
        request.auth.uid == resource.data.createdBy ||
        // 他人は「いいね」の付け外しだけ。しかも自分ぶんの±1に限る
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likeCount', 'likedBy']) && isOwnLikeToggle())
      );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
    }
    match /stones/{stoneId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
    }
  }
}
